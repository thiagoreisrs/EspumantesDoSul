# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Claude ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — "medium" é o equilíbrio para atendimento
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=2000
AGENT_MAX_ITERATIONS=6

# ─── Chatwoot ────────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
# Token do Agent Bot (Configurações → Agent Bots → criar bot)
CHATWOOT_BOT_TOKEN=
# Segredo que compõe a URL do webhook. Gere com: openssl rand -hex 24
CHATWOOT_WEBHOOK_SECRET=
# IDs das inboxes de WhatsApp atendidas pelo bot (vazio = todas)
CHATWOOT_INBOX_IDS=
# Time que recebe as conversas escaladas (opcional)
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_ESCALATION_LABEL=escalado-bot
CHATWOOT_MUTE_LABEL=bot-pausado

# ─── Shopify ─────────────────────────────────────────────────────────────────
SHOPIFY_SHOP_DOMAIN=espumantesdosul.myshopify.com
# Admin API access token de um app privado/custom (shpat_...)
# Escopos necessários: read_orders, read_products, read_inventory, read_fulfillments
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ─── Olist Tiny ERP (API v3) ─────────────────────────────────────────────────
OLIST_ENABLED=true
OLIST_API_BASE_URL=https://api.tiny.com.br/public-api/v3
OLIST_TOKEN_URL=https://accounts.tiny.com.br/realms/tiny/protocol/openid-connect/token
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REFRESH_TOKEN=
# Precisa ser um caminho gravável e persistente (volume), não o filesystem do container
OLIST_TOKEN_STORE=/data/.olist-token.json

# ─── Comportamento ───────────────────────────────────────────────────────────
DEBOUNCE_MS=8000
HISTORY_LIMIT=20
TIMEZONE=America/Sao_Paulo
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
# 0=domingo ... 6=sábado
BUSINESS_DAYS=1,2,3,4,5
